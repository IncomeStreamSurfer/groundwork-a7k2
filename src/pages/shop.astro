---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { supabase, type Product } from '../lib/supabase';

const { data } = await supabase
  .from('groundwork_products')
  .select('*')
  .order('featured', { ascending: false })
  .order('category');

const products = (data ?? []) as Product[];
const coffee = products.filter((p) => p.category === 'coffee');
const equipment = products.filter((p) => p.category === 'equipment');
const bundles = products.filter((p) => p.category === 'bundle');

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Shop All Coffee & Brewing Equipment',
  description: 'Browse the full Groundwork catalog of specialty coffee and brewing tools.',
  url: new URL('/shop', Astro.site).toString(),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() || '' },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: new URL('/shop', Astro.site).toString() },
  ],
};
---
<Base
  title="Shop All Products | Groundwork Coffee Co."
  description="Browse our full selection of specialty coffee beans and barista-grade brewing gear. Find your perfect roast or upgrade your setup today."
  structuredData={[collectionSchema, breadcrumbSchema]}
  currentPath="/shop"
>
  <section class="max-w-7xl mx-auto px-5 md:px-8 pt-14 md:pt-20 pb-8">
    <nav class="text-xs opacity-60 mb-6"><a href="/" class="hover:underline">Home</a> / <span>Shop</span></nav>
    <h1 class="text-5xl md:text-7xl leading-[0.95] mb-5 max-w-3xl">Shop All Coffee & Brewing Equipment</h1>
    <p class="text-lg opacity-70 max-w-2xl">Every bag. Every tool. Everything we stand behind. Use the jump-links below or scroll through the full collection. Free shipping on U.S. orders over $50.</p>
    <div class="flex flex-wrap gap-2 mt-8 text-sm">
      <a href="#coffee" class="px-4 py-2 rounded-full bg-[color:var(--color-espresso)]/10 hover:bg-[color:var(--color-espresso)] hover:text-[color:var(--color-cream)] transition">Coffee</a>
      <a href="#equipment" class="px-4 py-2 rounded-full bg-[color:var(--color-espresso)]/10 hover:bg-[color:var(--color-espresso)] hover:text-[color:var(--color-cream)] transition">Brewing Gear</a>
      <a href="#bundles" class="px-4 py-2 rounded-full bg-[color:var(--color-espresso)]/10 hover:bg-[color:var(--color-espresso)] hover:text-[color:var(--color-cream)] transition">Bundles</a>
      <a href="/coffee" class="px-4 py-2 rounded-full border border-[color:var(--color-espresso)]/20 hover:border-[color:var(--color-espresso)] transition">All coffee →</a>
      <a href="/utensils" class="px-4 py-2 rounded-full border border-[color:var(--color-espresso)]/20 hover:border-[color:var(--color-espresso)] transition">All utensils →</a>
    </div>
  </section>

  <section id="bundles" class="max-w-7xl mx-auto px-5 md:px-8 py-12 scroll-mt-20">
    <div class="flex items-end justify-between mb-8"><h2 class="text-3xl md:text-4xl">Bundles</h2><p class="text-sm opacity-60 hidden md:block">Save when you buy the set.</p></div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{bundles.map((p) => <ProductCard product={p} />)}</div>
  </section>

  <section id="coffee" class="max-w-7xl mx-auto px-5 md:px-8 py-12 scroll-mt-20 border-t border-[color:var(--color-espresso)]/10">
    <div class="flex items-end justify-between mb-8"><h2 class="text-3xl md:text-4xl">Coffee</h2><a href="/coffee" class="text-sm underline underline-offset-4 hover:text-[color:var(--color-copper)]">View all coffee →</a></div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{coffee.map((p) => <ProductCard product={p} />)}</div>
  </section>

  <section id="equipment" class="max-w-7xl mx-auto px-5 md:px-8 py-12 scroll-mt-20 border-t border-[color:var(--color-espresso)]/10">
    <div class="flex items-end justify-between mb-8"><h2 class="text-3xl md:text-4xl">Brewing Gear</h2><a href="/utensils" class="text-sm underline underline-offset-4 hover:text-[color:var(--color-copper)]">View all utensils →</a></div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{equipment.map((p) => <ProductCard product={p} />)}</div>
  </section>

  <section class="max-w-5xl mx-auto px-5 md:px-8 py-16 text-center">
    <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-copper)] mb-3">Need help choosing?</p>
    <h2 class="text-3xl md:text-4xl mb-4">Not sure where to start?</h2>
    <p class="opacity-70 max-w-xl mx-auto mb-6">If you're new to specialty coffee, grab the House Blend or the Home Barista Starter Bundle. Already a pour-over nerd? Go for the Ethiopian Yirgacheffe and the Complete Pour-Over Set. Check the <a href="/faq" class="underline underline-offset-4">FAQ</a> or see <a href="/shipping-returns" class="underline underline-offset-4">shipping &amp; returns</a>.</p>
  </section>
</Base>
