---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { supabase, type Product } from '../../lib/supabase';

const { data } = await supabase
  .from('groundwork_products')
  .select('*')
  .eq('category', 'equipment')
  .order('featured', { ascending: false })
  .order('price_pence', { ascending: false });

const products = (data ?? []) as Product[];

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Professional Coffee Brewing Equipment & Utensils', description: 'Shop barista-grade coffee brewing gear: grinders, kettles, presses, and espresso accessories.', url: new URL('/utensils', Astro.site).toString() },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() || '' },
    { '@type': 'ListItem', position: 2, name: 'Utensils', item: new URL('/utensils', Astro.site).toString() },
  ] },
];
---
<Base
  title="Coffee Brewing Equipment & Utensils | Groundwork Coffee Co."
  description="Upgrade your home coffee setup with barista-grade brewing gear. Shop pour-over kits, French presses, grinders, and more at Groundwork Coffee Co."
  structuredData={schema}
  currentPath="/utensils"
>
  <section class="max-w-7xl mx-auto px-5 md:px-8 pt-14 md:pt-20 pb-10">
    <nav class="text-xs opacity-60 mb-6"><a href="/" class="hover:underline">Home</a> / <span>Utensils</span></nav>
    <div class="grid md:grid-cols-[1fr_1.3fr] gap-10 md:gap-16 items-end">
      <div class="aspect-[5/4] rounded-2xl overflow-hidden order-2 md:order-1">
        <img src="https://images.unsplash.com/photo-1541167760496-1628856ab772?w=1200&q=80" alt="Precision coffee scale and grinder on a clean countertop" class="w-full h-full object-cover" loading="eager" />
      </div>
      <div class="order-1 md:order-2">
        <p class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-copper)] mb-4">Built to last. Built to brew.</p>
        <h1 class="text-5xl md:text-7xl leading-[0.95] mb-6">Professional Coffee Brewing Equipment & Utensils</h1>
        <p class="text-lg opacity-70 max-w-xl leading-relaxed">The gear on this page is the gear we put on our own counters. Conical burr grinders that hold their calibration. Gooseneck kettles that pour like a dream. Tampers that feel solid in your hand. Everything you need to turn the morning ritual into a craft — without the chrome-plated disposables.</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="/utensils/coffee-grinder" class="btn-secondary text-sm">Grinders</a>
          <a href="/utensils/pour-over-set" class="btn-secondary text-sm">Pour-Over</a>
          <a href="/utensils/espresso-accessories" class="btn-secondary text-sm">Espresso</a>
          <a href="/coffee" class="btn-secondary text-sm">Coffee →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-5 md:px-8 py-12 border-t border-[color:var(--color-espresso)]/10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{products.map((p) => <ProductCard product={p} />)}</div>
  </section>

  <section class="bg-[color:var(--color-crema)]/40 border-y border-[color:var(--color-espresso)]/10">
    <div class="max-w-5xl mx-auto px-5 md:px-8 py-16 md:py-20 grid md:grid-cols-3 gap-8">
      <div><div class="text-xl mb-2 font-[Fraunces]">01 · Grind</div><p class="text-sm opacity-70 leading-relaxed">Consistency is the biggest upgrade you can make to your coffee. A burr grinder is the one piece of gear that changes everything.</p></div>
      <div><div class="text-xl mb-2 font-[Fraunces]">02 · Pour</div><p class="text-sm opacity-70 leading-relaxed">Temperature and flow rate are the difference between sour and syrupy. A gooseneck kettle gives you both.</p></div>
      <div><div class="text-xl mb-2 font-[Fraunces]">03 · Press</div><p class="text-sm opacity-70 leading-relaxed">Whether it's a 30-pound tamp or a French press plunge, the last step decides the cup. Gear that respects the craft.</p></div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-5 md:px-8 py-16 text-center">
    <h2 class="text-3xl md:text-4xl mb-4">Have the gear. Need the beans?</h2>
    <p class="opacity-70 max-w-xl mx-auto mb-6">We roast twelve specialty coffees in small batches, shipped the day they come off the roaster. Find your <a href="/coffee" class="underline">next single origin</a> or go classic with the <a href="/coffee/dark-roast-blend" class="underline">House Dark Roast Blend</a>.</p>
    <a href="/coffee" class="btn-primary">Shop Coffee</a>
  </section>
</Base>
