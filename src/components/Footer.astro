---
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[color:var(--color-espresso)]/10 bg-[color:var(--color-bean)] text-[color:var(--color-cream)]">
  <div class="max-w-7xl mx-auto px-5 md:px-8 py-14 grid grid-cols-2 md:grid-cols-5 gap-10">
    <div class="col-span-2 md:col-span-2">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-8 h-8 rounded-full bg-[color:var(--color-cream)] text-[color:var(--color-espresso)] flex items-center justify-center text-sm font-semibold">G</span>
        <span class="font-[Fraunces] text-xl">Groundwork Coffee Co.</span>
      </div>
      <p class="text-sm opacity-70 max-w-sm leading-relaxed">From bean to brew, done right. Specialty coffee, roasted to order. Professional-grade gear for the serious home barista.</p>
      <form id="footer-sub" class="mt-5 flex gap-2 max-w-sm">
        <input type="email" required name="email" placeholder="your@email.com" class="flex-1 bg-transparent border border-[color:var(--color-cream)]/30 rounded-full px-4 py-2.5 text-sm placeholder:opacity-50" />
        <button type="submit" class="bg-[color:var(--color-cream)] text-[color:var(--color-espresso)] px-4 rounded-full text-sm font-medium hover:bg-[color:var(--color-copper)] hover:text-white transition">Subscribe</button>
      </form>
      <p id="footer-sub-msg" class="text-xs mt-2 opacity-60"></p>
    </div>
    <div>
      <h4 class="font-[Fraunces] text-base mb-3">Shop</h4>
      <ul class="space-y-2 text-sm opacity-80">
        <li><a href="/coffee" class="hover:opacity-60">All Coffee</a></li>
        <li><a href="/utensils" class="hover:opacity-60">Utensils</a></li>
        <li><a href="/shop" class="hover:opacity-60">Everything</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-[Fraunces] text-base mb-3">Company</h4>
      <ul class="space-y-2 text-sm opacity-80">
        <li><a href="/about" class="hover:opacity-60">Our Story</a></li>
        <li><a href="/blog" class="hover:opacity-60">Journal</a></li>
        <li><a href="/contact" class="hover:opacity-60">Contact</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-[Fraunces] text-base mb-3">Help</h4>
      <ul class="space-y-2 text-sm opacity-80">
        <li><a href="/faq" class="hover:opacity-60">FAQ</a></li>
        <li><a href="/shipping-returns" class="hover:opacity-60">Shipping &amp; Returns</a></li>
        <li><a href="/cart" class="hover:opacity-60">Cart</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[color:var(--color-cream)]/10 py-5">
    <div class="max-w-7xl mx-auto px-5 md:px-8 flex flex-col md:flex-row justify-between gap-3 text-xs opacity-60">
      <p>© {year} Groundwork Coffee Co. All rights reserved.</p>
      <p>From bean to brew, done right.</p>
    </div>
  </div>
</footer>
<script is:inline>
  (function(){
    const f = document.getElementById('footer-sub');
    if (!f) return;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(f);
      const email = data.get('email');
      const msg = document.getElementById('footer-sub-msg');
      if (msg) msg.textContent = 'Subscribing…';
      try {
        const r = await fetch('/api/subscribe', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify({ email }) });
        const j = await r.json();
        if (msg) msg.textContent = r.ok ? 'Thanks — welcome to the list.' : (j.error || 'Something went wrong');
        if (r.ok) f.reset();
      } catch(_) {
        if (msg) msg.textContent = 'Network error';
      }
    });
  })();
</script>
